{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": [
        "index.html",
        "setup.html",
        "resources.html",
        "faq.html",
        "lesson-note-generator.html",
        "exam-generator.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}